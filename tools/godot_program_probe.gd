extends SceneTree
const Model: GDScript = preload("res://addons/ali_assets/game_model.gd")
const Library: GDScript = preload("res://addons/ali_assets/game_library.gd")
const Builder: GDScript = preload("res://addons/ali_assets/game_builder.gd")
var data: Dictionary
var game: Node2D


func _initialize() -> void:
	call_deferred("run")


func node(id: String, kind: String, parameters: Dictionary = {}) -> void:
	var item: Dictionary = Model.module(id, kind, float(data["nodes"].size() % 5) * 320, float(data["nodes"].size() / 5) * 300)
	item["params"].merge(parameters, true)
	data["nodes"].append(item)


func edge(source: String, output: int, target: String, input: int) -> void:
	data["edges"].append({"from": source, "from_port": output, "to": target, "to_port": input})


func save_json(path: String, contents: Dictionary) -> void:
	var file: FileAccess = FileAccess.open(path, FileAccess.WRITE)
	file.store_string(JSON.stringify(contents, "\t"))
	file.close()


func execute(id: String, port: int = 0) -> void:
	game.call("deliver", id, port)


func run() -> void:
	data = Model.scene_preset()
	node("counter", "blackboard", {"name": "counter"})
	node("one", "number", {"value": 1.0})
	node("sum", "math")
	node("write", "set_variable", {"name": "counter"})
	edge("counter", 0, "sum", 0)
	edge("one", 0, "sum", 1)
	edge("sum", 0, "write", 1)
	node("compare", "compare", {"b": 0.0})
	node("logic", "logic", {"b": true})
	node("branch", "branch")
	node("passed", "log", {"text": "data chain passed"})
	edge("counter", 0, "compare", 0)
	edge("compare", 0, "logic", 0)
	edge("logic", 0, "branch", 1)
	edge("write", 0, "branch", 0)
	edge("branch", 0, "passed", 0)
	node("once", "do_once")
	node("gate", "gate")
	node("flip", "flip_flop")
	node("cool", "cooldown", {"seconds": 0.5})
	for id: String in ["once", "gate", "flip", "cool"]:
		edge(id, 0, "write", 0)
	node("fsm", "fsm", {"name": "states", "states": "idle,attack,dead", "transitions": "idle>attack;attack>dead"})
	node("attack", "set_state", {"name": "states", "state": "attack"})
	node("illegal", "set_state", {"name": "states", "state": "idle"})
	node("health", "health", {"initial": 30.0, "max": 30.0})
	node("dead", "set_state", {"name": "states", "state": "dead"})
	edge("health", 1, "dead", 0)
	node("event", "event_emit", {"name": "hello", "text": "first"})
	node("listen", "event_listener", {"name": "hello"})
	node("payload_log", "log")
	edge("listen", 0, "payload_log", 0)
	edge("listen", 1, "payload_log", 1)
	node("text", "text", {"value": "a message"})
	node("format", "format_text", {"template": "Count {value}"})
	node("notice", "ui_message")
	edge("counter", 0, "format", 0)
	edge("format", 0, "notice", 1)
	node("spawn", "spawn_scene", {"scene": "res://fixtures/entity.tscn", "limit": 1})
	node("move", "node_action", {"target": "Entity", "op": "translate", "x": 12.0})
	node("signal", "signal_event", {"target": "Entity", "signal": "activated"})
	node("signal_log", "log")
	node("exit_signal", "signal_event", {"target": "Entity", "signal": "tree_exiting"})
	edge("exit_signal", 0, "health", 0)
	edge("signal", 0, "signal_log", 0)
	edge("signal", 1, "signal_log", 1)
	node("key", "key_event", {"key": KEY_J})
	edge("key", 0, "health", 0)
	node("value", "game_value")
	# A real reusable task waits via its outgoing delayed completion.
	var delay: Dictionary = Model.module("wait", "delay", 0, 0)
	delay["params"]["seconds"] = 0.1
	save_json("res://fixtures/task.json", {"version": 1, "type": "flow_module", "nodes": [delay], "edges": [], "entry": {"node": "wait", "port": 0}, "exit": {"node": "wait", "port": 0}})
	node("task", "module", {"path": "res://fixtures/task.json"})
	node("after_task", "log", {"text": "task completed"})
	edge("task", 0, "after_task", 0)
	var local: Dictionary = Model.module("local", "blackboard", 0, 0)
	local["params"]["name"] = "counter"
	var setter: Dictionary = Model.module("setter", "set_variable", 0, 100)
	setter["params"].merge({"name": "counter", "number": 5.0}, true)
	save_json("res://fixtures/local_task.json", {"version":1,"type":"flow_module","nodes":[local,setter],"edges":[],"entry":{"node":"setter","port":0},"exit":{"node":"setter","port":0}})
	node("left", "module", {"path": "res://fixtures/local_task.json"})
	node("right", "module", {"path": "res://fixtures/local_task.json"})
	var recursive: Dictionary = Model.module("self_call", "module", 0, 0)
	recursive["params"]["path"] = "res://fixtures/recursive.json"
	save_json("res://fixtures/recursive.json", {"version":1,"type":"flow_module","nodes":[recursive],"edges":[],"entry":{"node":"self_call","port":0},"exit":{"node":"self_call","port":0}})
	var recursive_graph: Dictionary = Model.scene_preset()
	recursive_graph["nodes"].append(recursive)
	assert("递归" in str(Library.compile(recursive_graph).get("error", "")))
	node("loop_a", "log")
	node("loop_b", "log")
	edge("loop_a", 0, "loop_b", 0)
	edge("loop_b", 0, "loop_a", 0)
	node("restart_wait", "delay", {"seconds": 0.01})
	node("stale_wait", "delay", {"seconds": 0.01})
	edge("restart_wait", 0, "session", 2)
	edge("stale_wait", 0, "write", 0)
	var entity: Node2D = Node2D.new()
	entity.set_script(load("res://fixtures/entity.gd"))
	var packed: PackedScene = PackedScene.new()
	assert(packed.pack(entity) == OK and ResourceSaver.save(packed, "res://fixtures/entity.tscn") == OK)
	entity.free()
	assert(Model.validate(data, true).is_empty(), Model.validate(data, true))
	var invalid: Dictionary = data.duplicate(true)
	invalid["edges"].append({"from": "text", "from_port": 0, "to": "sum", "to_port": 0})
	assert(not Model.validate(invalid).is_empty())
	invalid = data.duplicate(true)
	invalid["edges"] = invalid["edges"].filter(func(item: Dictionary) -> bool: return item["to"] != "sum")
	var second: Dictionary = Model.module("second", "math", 0, 0)
	invalid["nodes"].append(second)
	invalid["edges"].append_array([{"from":"sum","from_port":0,"to":"second","to_port":0},{"from":"second","from_port":0,"to":"sum","to_port":0}])
	assert("循环" in Model.validate(invalid))
	invalid = data.duplicate(true)
	Model.find(invalid, "write")["params"]["value_type"] = "text"
	invalid["edges"] = invalid["edges"].filter(func(item: Dictionary) -> bool: return item["to"] != "write" or item["to_port"] == 0)
	assert(not Model.validate(invalid, true).is_empty())
	assert(Builder.create_scene(data, "res://program_game.tscn").is_empty())
	# A compiled game runs even when the editable macro source is absent.
	assert(DirAccess.rename_absolute("res://fixtures/task.json", "res://fixtures/task.hidden") == OK)
	game = (load("res://program_game.tscn") as PackedScene).instantiate()
	root.add_child(game)
	await process_frame
	assert(game.get("initialized") and game.get("actor") == null)
	game.call("session_command", 0)
	var program: RefCounted = game.get("program")
	execute("left__setter")
	assert(game.get("variables")["left__counter"] == 5.0 and game.get("variables")["right__counter"] == 0.0 and game.get("variables")["counter"] == 0.0)
	execute("write")
	assert(is_equal_approx(float(game.get("variables")["counter"]), 1.0))
	assert(str(program.get("trace")).contains("data chain passed"))
	execute("once")
	execute("once")
	assert(game.get("variables")["counter"] == 2.0)
	execute("once", 1)
	execute("once")
	assert(game.get("variables")["counter"] == 3.0)
	execute("gate", 2)
	execute("gate")
	assert(game.get("variables")["counter"] == 3.0)
	execute("gate", 1)
	execute("gate")
	execute("flip")
	execute("flip")
	assert(game.get("variables")["counter"] == 5.0)
	execute("cool")
	execute("cool")
	assert(game.get("variables")["counter"] == 6.0)
	game.call("session_command", 3)
	var frozen: float = program.get("clock")
	game.call("_process", 1.0)
	assert(program.get("clock") == frozen)
	game.call("session_command", 3)
	program.call("tick", 0.6)
	execute("cool")
	assert(game.get("variables")["counter"] == 7.0)
	execute("attack")
	execute("illegal")
	assert(program.get("machines")["states"]["current"] == "attack")
	execute("health")
	execute("health")
	assert(program.get("health")["health"]["value"] == 20.0)
	program.call("tick", 0.4)
	execute("health")
	program.call("tick", 0.4)
	execute("health")
	assert(program.get("health")["health"]["value"] == 0.0 and program.get("machines")["states"]["current"] == "dead")
	# Two queued events preserve independent payloads across downstream execution.
	game.set("routing", true)
	game.call("queue_event", "listen", "first payload")
	game.call("queue_event", "listen", "second payload")
	game.set("routing", false)
	game.call("drain")
	assert(str(program.get("trace")).contains("first payload") and str(program.get("trace")).contains("second payload"))
	execute("event")
	execute("notice")
	assert((game.get("hud").get("notifications") as Label).text == "Count 7.0")
	execute("spawn")
	execute("spawn")
	assert(program.get("instances")["spawn"].size() == 1)
	var spawned: Node2D = game.get_node("Entity") as Node2D
	execute("move")
	assert(spawned.position == Vector2(212, 200))
	spawned.call("trigger", 42)
	assert(str(program.get("trace")).contains('"detail": "42"'))
	game.call("session_command", 3)
	assert(spawned.process_mode == Node.PROCESS_MODE_DISABLED)
	game.call("session_command", 3)
	assert(spawned.process_mode == Node.PROCESS_MODE_INHERIT)
	game.call("deliver", "task__wait", 0)
	assert(not str(program.get("trace")).contains("task completed"))
	game.call("_process", 0.12)
	assert(str(program.get("trace")).contains("task completed"))
	# A restart from one due delay cancels other old-run delays and cleanup signals.
	execute("restart_wait")
	execute("stale_wait")
	game.call("_process", 0.02)
	assert(game.get("variables")["counter"] == 0.0 and program.get("health")["health"]["value"] == 30.0)
	assert(program.get("instances")["spawn"].is_empty())
	game.call("emit_port", "loop_a", 0)
	assert(program.get("fault_count") == 1 and game.get("queue").is_empty() and not game.get("routing"))
	for index: int in range(300):
		program.call("record", "passed", str(index))
	assert(program.get("trace").size() == 256)
	game.call("write_debug")
	assert(FileAccess.file_exists(str(game.get("debug_path"))))
	game.queue_free()
	await process_frame
	assert(DirAccess.rename_absolute("res://fixtures/task.hidden", "res://fixtures/task.json") == OK)
	save_json("res://program-proof.json", {"typed_data_fresh_after_write": true, "compiler_rejects_mismatch_and_cycle": true, "flow_reset_and_cooldown": true, "pause_freezes_clock_and_spawn": true, "fsm_allowed_transitions": true, "health_immunity_and_depletion": true, "independent_event_payloads": true, "native_scene_spawn_and_signal": true, "compiled_macro_without_source": true, "macro_local_scope_and_recursion_guard": true, "restart_cleans_instances": true, "bounded_trace_and_execution_loop_guard": true, "game_modules": Model.TITLES.size()})
	OS.delay_msec(250)
	quit()
