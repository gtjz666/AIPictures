@tool
extends EditorPlugin
const Model: GDScript = preload("res://addons/ali_assets/blueprint_model.gd")

func _enter_tree() -> void:
	run.call_deferred()


func run() -> void:
	await get_tree().create_timer(0.5).timeout
	var ali: Node = get_tree().get_first_node_in_group("ali_assets_editor")
	assert(ali != null)
	EditorInterface.get_selection().clear()
	ali.call("open_blueprint")
	var window: Window = ali.get("blueprint") as Window
	assert(window.visible and window.force_native)
	var graph: GraphEdit = window.get("graph") as GraphEdit
	assert(graph != null)
	var rows: Array = JSON.parse_string(FileAccess.get_file_as_string("res://probe-inputs.json"))
	for record: Dictionary in rows:
		var path: String = str(record["resource"])
		EditorInterface.open_scene_from_path(path)
		await get_tree().create_timer(0.3).timeout
		var character: Node = EditorInterface.get_edited_scene_root()
		assert(character is CharacterBody2D)
		window.set("dirty", false)
		assert(window.call("bind_character", character))
		var data: Dictionary = window.get("data").duplicate(true)
		assert(Model.validate(data).is_empty())
		for common: int in range(3):
			window.call("add_common_module", common)
			assert(Model.validate(window.get("data")).is_empty())
			(window.get("history") as UndoRedo).undo()
		window.call("add_module", "custom")
		var module_id: String = str(window.get("data")["nodes"][-1]["id"])
		window.set("sound_id", module_id)
		window.set("file_operation", "new_module")
		window.call("on_file_selected", "res://sources/template_" + str(record["preset"]) + ".gd")
		assert(FileAccess.file_exists("res://sources/template_" + str(record["preset"]) + ".gd"))
		assert(not Model.find_node(window.get("data"), module_id)["params"]["script"].is_empty())
		(window.get("history") as UndoRedo).undo()
		(window.get("history") as UndoRedo).undo()
		window.set("capture_id", "key_attack")
		var event: InputEventKey = InputEventKey.new()
		event.pressed = true
		event.physical_keycode = KEY_K
		window.call("on_window_input", event)
		data = window.get("data").duplicate(true)
		assert(int(Model.find_node(data, "key_attack")["params"]["code"]) == KEY_K)
		var undo: UndoRedo = window.get("history") as UndoRedo
		undo.undo()
		assert(int(Model.find_node(window.get("data"), "key_attack")["params"]["code"]) == KEY_J)
		undo.redo()
		data = window.get("data").duplicate(true)
		data["nodes"].append(Model.make_node("after_attack", "delay", 900, 1100, {"seconds": 0.2}))
		data["edges"].append({"from": "anim_attack", "to": "after_attack"})
		data["nodes"].append(Model.make_node("sfx_attack", "sound", 900, 800, {"path": "res://sources/tone.wav", "trigger": "frame", "frame": 2, "interval": 0.2, "volume": -6.0}))
		data["nodes"].append(Model.make_node("sfx_walk", "sound", 900, 0, {"path": "res://sources/tone.wav", "trigger": "repeat", "frame": 0, "interval": 0.2, "volume": -9.0}))
		assert(window.call("change", "音效模块", data))
		graph.connection_request.emit(&"anim_attack", 0, &"sfx_attack", 0)
		graph.connection_request.emit(&"anim_move_right", 0, &"sfx_walk", 0)
		assert(graph.is_node_connected(&"anim_attack", 0, &"sfx_attack", 0))
		var before: int = window.get("data")["edges"].size()
		graph.connection_request.emit(&"sfx_attack", 0, &"key_attack", 0)
		assert(window.get("data")["edges"].size() == before)
		graph.disconnection_request.emit(&"anim_attack", 0, &"sfx_attack", 0)
		assert(not graph.is_node_connected(&"anim_attack", 0, &"sfx_attack", 0))
		undo.undo()
		assert(graph.is_node_connected(&"anim_attack", 0, &"sfx_attack", 0))
		var node: GraphNode = graph.get_node("sfx_attack") as GraphNode
		node.dragged.emit(Vector2(900, 800), Vector2(920, 850))
		assert(window.get("data")["nodes"][-2]["position"] == [920.0, 850.0])
		window.set("file_operation", "save")
		window.call("on_file_selected", "res://saved_" + str(record["preset"]) + ".json")
		var saved_json: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://saved_" + str(record["preset"]) + ".json"))
		assert(saved_json == JSON.parse_string(JSON.stringify(window.get("data"))))
		window.call("apply_to_character")
		assert(not character.get("blueprint").is_empty())
		var manager: EditorUndoRedoManager = ali.call("get_undo_redo")
		var scene_history: UndoRedo = manager.get_history_undo_redo(manager.get_object_history_id(character))
		scene_history.undo()
		assert(character.get("blueprint").is_empty())
		scene_history.redo()
		assert(JSON.parse_string(JSON.stringify(character.get("blueprint"))) == saved_json)
		var packed: PackedScene = PackedScene.new()
		assert(packed.pack(character) == OK and ResourceSaver.save(packed, path) == OK)
		var fresh: PackedScene = ResourceLoader.load(path, "PackedScene", ResourceLoader.CACHE_MODE_IGNORE) as PackedScene
		var copy: Node = fresh.instantiate()
		assert(JSON.parse_string(JSON.stringify(copy.get("blueprint"))) == saved_json)
		copy.free()
	window.hide()
	var file: FileAccess = FileAccess.open("res://blueprint-proof.json", FileAccess.WRITE)
	file.store_string(JSON.stringify({"native_window": true, "graph_wires": true, "key_rebound": true, "graph_and_scene_undo_redo": true, "three_presets_persisted": true, "sound_frame_mapping": true}))
	file.close()
	print("ALI_EDITOR_GRAPH_OK")
	get_tree().quit.call_deferred(0)
